# AI智学 环境变量配置
# 复制此文件为 .env 并填入真实值

# === 讯飞星火大模型 ===
IFLYTEK_APP_ID=your_app_id_here
IFLYTEK_API_KEY=your_api_key_here
IFLYTEK_API_SECRET=your_api_secret_here
# OpenAI兼容接口的APIPassword (从 console.xfyun.cn 获取)
IFLYTEK_API_PASSWORD=your_api_password_here

# === 模型配置 ===
SPARK_MODEL_PRIMARY=4.0Ultra
SPARK_MODEL_LITE=lite
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/v1

# === 数据库 ===
DATABASE_URL=sqlite+aiosqlite:///./data/ai_learning.db

# === ChromaDB ===
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=ai_course_knowledge

# === 应用配置 ===
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key

# === 前端 ===
FRONTEND_URL=http://localhost:3000
